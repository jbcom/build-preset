{
  "name": "build-preset",
  "version": "0.4.1",
  "description": "Shared build conventions for browser games: Vite 8 and Vitest configs with headed, muted browser testing, a Capacitor config, a tsup library build, and TypeScript and Biome base configs.",
  "type": "module",
  "license": "MIT",
  "author": "Jon Bogaty <jon@jonbogaty.com>",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "sideEffects": false,
  "main": "./dist/cjs/index.cjs",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "bin": {
    "build-preset": "./dist/esm/cli.js"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.cts",
        "default": "./dist/cjs/index.cjs"
      }
    },
    "./vite": {
      "import": {
        "types": "./dist/esm/vite.d.ts",
        "default": "./dist/esm/vite.js"
      },
      "require": {
        "types": "./dist/cjs/vite.d.cts",
        "default": "./dist/cjs/vite.cjs"
      }
    },
    "./vitest": {
      "import": {
        "types": "./dist/esm/vitest.d.ts",
        "default": "./dist/esm/vitest.js"
      },
      "require": {
        "types": "./dist/cjs/vitest.d.cts",
        "default": "./dist/cjs/vitest.cjs"
      }
    },
    "./capacitor": {
      "import": {
        "types": "./dist/esm/capacitor.d.ts",
        "default": "./dist/esm/capacitor.js"
      },
      "require": {
        "types": "./dist/cjs/capacitor.d.cts",
        "default": "./dist/cjs/capacitor.cjs"
      }
    },
    "./tsup": {
      "import": {
        "types": "./dist/esm/tsup.d.ts",
        "default": "./dist/esm/tsup.js"
      },
      "require": {
        "types": "./dist/cjs/tsup.d.cts",
        "default": "./dist/cjs/tsup.cjs"
      }
    },
    "./tsconfig.base.json": "./tsconfig.base.json",
    "./biome.base.json": "./biome.base.json",
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "vite": [
        "./dist/esm/vite.d.ts"
      ],
      "vitest": [
        "./dist/esm/vitest.d.ts"
      ],
      "capacitor": [
        "./dist/esm/capacitor.d.ts"
      ],
      "tsup": [
        "./dist/esm/tsup.d.ts"
      ],
      "*": [
        "./dist/esm/index.d.ts"
      ]
    }
  },
  "files": [
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "biome.base.json",
    "dist",
    "docs/API.md",
    "docs/ARCHITECTURE.md",
    "tsconfig.base.json"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "prepack": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "lint:docs": "markdownlint-cli2 README.md CONTRIBUTING.md SECURITY.md CODE_OF_CONDUCT.md CHANGELOG.md AGENTS.md \"docs/**/*.md\" \"!docs/node_modules/**\" \"!docs/dist/**\" .github/PULL_REQUEST_TEMPLATE.md",
    "package:check": "publint && attw --pack . --profile node16",
    "smoke:consumer": "node scripts/consumer-smoke.mjs",
    "verify": "pnpm run lint && pnpm run lint:docs && pnpm run typecheck && pnpm run coverage && pnpm run build && pnpm run package:check && pnpm run smoke:consumer",
    "docs:dev": "pnpm --filter build-preset-docs dev",
    "docs:build": "pnpm --filter build-preset-docs build",
    "docs:check": "pnpm --filter build-preset-docs check",
    "prepare": "simple-git-hooks"
  },
  "peerDependencies": {
    "@vitest/browser-playwright": "^4.1.10 || ^5.0.0",
    "playwright": ">=1.62.1 <2",
    "tsup": "^8.5.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.10 || ^5.0.0"
  },
  "peerDependenciesMeta": {
    "@vitest/browser-playwright": {
      "optional": false
    },
    "playwright": {
      "optional": false
    },
    "tsup": {
      "optional": true
    },
    "vite": {
      "optional": false
    },
    "vitest": {
      "optional": false
    }
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@biomejs/biome": "2.5.15",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@types/node": "^24.13.3",
    "@vitest/browser-playwright": "^5.0.3",
    "@vitest/coverage-v8": "^5.0.3",
    "lint-staged": "^17.6.0",
    "markdownlint-cli2": "^0.23.3",
    "playwright": "^1.63.0",
    "publint": "^0.3.25",
    "simple-git-hooks": "^2.14.0",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm exec lint-staged",
    "commit-msg": "pnpm exec commitlint --edit $1"
  },
  "lint-staged": {
    "*.{ts,js,mjs,cjs,json}": [
      "biome check --write --no-errors-on-unmatched"
    ],
    "*.md": [
      "markdownlint-cli2"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jbcom/build-preset.git"
  },
  "bugs": {
    "url": "https://github.com/jbcom/build-preset/issues"
  },
  "homepage": "https://github.com/jbcom/build-preset#readme",
  "packageManager": "pnpm@12.10.1",
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "vite",
    "vitest",
    "playwright",
    "capacitor",
    "tsup",
    "biome",
    "tsconfig",
    "build-config",
    "game-development",
    "browser-testing"
  ]
}
